---
import { business } from "../data/business";
import { getCollection } from "astro:content";

const year = new Date().getFullYear();

const navLinks = [
  { href: "/services", label: "Services" },
  { href: "/about", label: "About Us" },
  { href: "/projects", label: "Solar Gallery" },
  { href: "/areas-we-serve", label: "Areas We Serve" },
  { href: "/coupons", label: "Incentives & Specials" },
  { href: "/community-mission", label: "Our Mission" },
  { href: "/blog", label: "Blog" },
  { href: "/careers", label: "Careers" },
  { href: "/contact", label: "Contact" },
];

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---
<footer class="bg-navy-800 text-white border-t-4 border-solar">
  <div class="max-w-7xl mx-auto px-6 py-14 grid gap-10 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <img
        src="/images/logo.png"
        alt={`${business.name} logo`}
        width="220"
        height="60"
        loading="lazy"
        class="h-12 w-auto object-contain"
      />
      <p class="mt-4 font-display text-base font-bold text-solar-light italic">
        "Clean, Dependable Solar Power &amp; Home Battery Backup for Texas"
      </p>
      <p class="mt-2 text-sm text-white/70">Residential · Commercial · Storage · 25-Year Warranty</p>
    </div>

    <div>
      <h2 class="font-display font-bold text-solar-light uppercase text-sm tracking-wider">Services</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {services.map((s) => (
          <li>
            <a href={`/services/${s.id}`} class="text-white/80 hover:text-solar-light transition-colors">
              {s.data.h1}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="font-display font-bold text-solar-light uppercase text-sm tracking-wider">Explore</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {navLinks.slice(0, 6).map((l) => (
          <li>
            <a href={l.href} class="text-white/80 hover:text-solar-light transition-colors">
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/blog" class="font-bold text-solar-light hover:text-white transition-colors">
            Solar Blog &amp; Guides →
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="font-display font-bold text-solar-light uppercase text-sm tracking-wider">Get in Touch</h2>
      <a href={business.phoneHref} class="mt-4 block font-display text-2xl font-extrabold text-white hover:text-solar-light transition-colors">
        {business.phone}
      </a>
      <p class="mt-2 text-sm text-solar-light font-semibold">{business.hoursDisplay}</p>
      <p class="mt-3 text-sm text-white/80">{business.address}</p>
      <p class="mt-1 text-sm text-white/60">Serving {business.areaServed} &amp; surrounding areas</p>
      
      <div class="mt-4 flex gap-3">
        <a href={business.socials.facebook} aria-label={`${business.name} on Facebook`} class="p-2 rounded-full bg-white/10 hover:bg-solar hover:text-navy transition-colors" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
        </a>
        <a href={business.socials.instagram} aria-label={`${business.name} on Instagram`} class="p-2 rounded-full bg-white/10 hover:bg-solar hover:text-navy transition-colors" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>
        </a>
        <a href={business.socials.google} aria-label={`${business.name} on Google`} class="p-2 rounded-full bg-white/10 hover:bg-solar hover:text-navy transition-colors" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 12v3.6h5.1c-.2 1.3-1.6 3.9-5.1 3.9-3.1 0-5.6-2.6-5.6-5.7s2.5-5.7 5.6-5.7c1.8 0 2.9.8 3.6 1.4l2.5-2.4C16.9 4.9 14.7 4 12 4 6.9 4 2.8 8.1 2.8 13.2S6.9 22.4 12 22.4c5.9 0 9.7-4.1 9.7-9.9 0-.7-.1-1.2-.2-1.7H12z"/></svg>
        </a>
        <a href={business.socials.tiktok} aria-label={`${business.name} on TikTok`} class="p-2 rounded-full bg-white/10 hover:bg-solar hover:text-navy transition-colors" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.94,1.61V15.78a2.83,2.83,0,0,1-2.83,2.83h0a2.83,2.83,0,0,1-2.83-2.83h0a2.84,2.84,0,0,1,2.83-2.84h0V9.17h0A6.61,6.61,0,0,0,3.5,15.78h0a6.61,6.61,0,0,0,6.61,6.61h0a6.61,6.61,0,0,0,6.61-6.61V9.17l.2.1a8.08,8.08,0,0,0,3.58.84h0V6.33l-.11,0a4.84,4.84,0,0,1-3.67-4.7H12.94Z"/></svg>
        </a>
        <a href={business.socials.youtube} aria-label={`${business.name} on Youtube`} class="p-2 rounded-full bg-white/10 hover:bg-solar hover:text-navy transition-colors" target="_blank" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 6.01c-.22-.19-.49-.3-.68-.37-.22-.08-.47-.14-.73-.19-.53-.11-1.2-.19-1.94-.25C15.69 5.06 13.84 5 12 5s-3.69.06-5.17.19c-.74.07-1.4.14-1.93.25-.26.05-.52.11-.74.19-.19.07-.46.18-.68.37-.21.18-.33.4-.4.55-.07.16-.13.34-.18.51-.09.35-.16.77-.21 1.21-.1.9-.15 2.02-.15 3.13 0 1.11.05 2.24.15 3.17.05.47.12.9.21 1.26.08.32.2.75.45 1.06.24.29.57.42.74.48.21.08.46.14.72.19.52.1 1.18.18 1.92.24 1.49.13 3.39.19 5.27.19s3.79-.06 5.27-.19c.74-.06 1.41-.14 1.93-.24.26-.05.5-.11.72-.19.16-.06.5-.19.74-.48.25-.31.38-.74.45-1.06.09-.36.16-.8.21-1.26.1-.93.15-2.06.15-3.17 0-1.11-.05-2.23-.15-3.13-.05-.44-.12-.86-.21-1.21-.05-.17-.1-.35-.18-.51-.06-.15-.18-.37-.4-.55zM10.1 14.36V8.64L14.54 11.5l-4.44 2.86z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <nav aria-label="Footer" class="max-w-7xl mx-auto px-6 pt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/70">
      {navLinks.map((l) => (
        <a href={l.href} class="hover:text-solar-light transition-colors">{l.label}</a>
      ))}
    </nav>
    <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-white/60">
      <p>© {year} {business.name}. {business.license}.</p>
      <p>{business.trustedPhrase} · {business.areaServed}</p>
    </div>
  </div>
</footer>
