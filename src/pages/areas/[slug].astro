---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScheduleButton from "../../components/ScheduleButton.astro";
import { business } from "../../data/business";
import { areas } from "../../data/areas";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");
  const svcMap = Object.fromEntries(services.map((s) => [s.id, s.data]));
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area, svcMap } }));
}

const { area, svcMap } = Astro.props;
const url = `${business.url}/areas/${area.slug}`;

const topServices = area.topServices
  .map((slug) => ({ slug, data: svcMap[slug] }))
  .filter((s) => s.data);

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": `${business.url}/#business`,
  name: business.name,
  telephone: business.phone,
  url,
  image: business.url + business.logo,
  priceRange: business.priceRange,
  address: {
    "@type": "PostalAddress",
    streetAddress: business.addressParts.street,
    addressLocality: business.addressParts.city,
    addressRegion: business.addressParts.state,
    postalCode: business.addressParts.zip,
    addressCountry: "US",
  },
  areaServed: { "@type": "City", name: `${area.name}, TX` },
  openingHours: business.hours,
  sameAs: [business.socials.facebook, business.socials.instagram, business.socials.google],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: business.url },
    { "@type": "ListItem", position: 2, name: "Areas We Serve", item: `${business.url}/areas-we-serve` },
    { "@type": "ListItem", position: 3, name: area.name, item: url },
  ],
};
---
<BaseLayout
  title={area.seoTitle}
  description={area.metaDescription}
  path={`/areas/${area.slug}`}
  jsonLd={[localBusinessSchema, breadcrumbSchema]}
>
  <!-- Hero -->
  <section class="bg-navy text-white border-b-4 border-solar">
    <div class="max-w-4xl mx-auto px-6 py-14">
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex items-center gap-2 text-xs font-semibold text-white/70">
          <li><a href="/" class="hover:text-solar-light">Home</a></li>
          <li>/</li>
          <li><a href="/areas-we-serve" class="hover:text-solar-light">Areas We Serve</a></li>
          <li>/</li>
          <li class="text-solar-light">{area.name}</li>
        </ol>
      </nav>
      <span class="font-display font-bold text-xs uppercase tracking-[0.2em] text-solar-light">
        {area.heroEyebrow}
      </span>
      <h1 class="hp-rise mt-3 font-display font-black text-3xl sm:text-5xl leading-tight">
        {area.h1}
      </h1>
      <p class="mt-4 text-white/85 text-lg leading-relaxed">
        {area.intro[0]}
      </p>
      <div class="mt-7 flex flex-col sm:flex-row gap-3">
        <a
          href={business.phoneHref}
          class="hp-lift inline-flex items-center justify-center gap-2 rounded-xl bg-solar px-6 py-3.5 font-display text-base font-bold text-navy shadow-md hover:bg-solar-dark hover:text-white transition-colors"
        >
          Call {business.phone}
        </a>
        <ScheduleButton class="px-6 py-3.5" />
      </div>
    </div>
  </section>

  <article class="max-w-4xl mx-auto px-6 py-14">
    <!-- Local context paragraphs -->
    <div class="space-y-4 text-navy/80 text-lg leading-relaxed">
      {area.intro.slice(1).map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <!-- Local Grid & Climate Challenges -->
    <div class="mt-12 bg-cream border border-navy/10 rounded-3xl p-8 sm:p-10 shadow-sm">
      <div class="flex items-center gap-3 text-solar-dark font-display font-bold text-sm uppercase tracking-wider mb-2">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Local Energy &amp; Weather Profile
      </div>
      <h2 class="font-display font-black text-2xl text-navy">Grid Demands in {area.name}</h2>
      <p class="mt-3 text-navy/75 leading-relaxed">
        {area.localChallenges}
      </p>
    </div>

    <!-- Top Recommended Services in this Area -->
    <div class="mt-14">
      <h2 class="font-display font-black text-2xl sm:text-3xl text-navy">Recommended Solar Services for {area.name}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {topServices.map((s) => (
          <a
            href={`/services/${s.slug}`}
            class="hp-lift group p-6 rounded-2xl bg-white border border-navy/10 hover:border-solar shadow-sm flex flex-col justify-between"
          >
            <div>
              <h3 class="font-display font-bold text-lg text-navy group-hover:text-solar-dark transition-colors">{s.data.h1}</h3>
              <p class="text-sm text-navy/60 mt-2 leading-relaxed">{s.data.summary}</p>
            </div>
            <span class="mt-4 font-display font-bold text-electric text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
              Learn more →
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Covered ZIP Codes -->
    <div class="mt-12 pt-8 border-t border-navy/10">
      <h3 class="font-display font-bold text-lg text-navy">ZIP Codes Served in {area.name}:</h3>
      <div class="mt-3 flex flex-wrap gap-2">
        {area.zips.map((zip) => (
          <span class="font-mono text-sm font-semibold bg-cream border border-navy/15 px-3 py-1 rounded-lg text-navy">
            {zip}
          </span>
        ))}
      </div>
    </div>

    <!-- CTA Box -->
    <div class="mt-16 bg-navy text-white rounded-3xl p-8 sm:p-12 text-center border-t-4 border-solar shadow-xl">
      <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-solar-light">Get Started in {area.name}</span>
      <h2 class="mt-2 font-display font-black text-2xl sm:text-3xl">Claim Your Free Solar Roof Analysis</h2>
      <p class="mt-3 text-white/80 max-w-xl mx-auto">
        Speak with our local {area.name} solar specialists today to see how much you can save with clean Texas solar power.
      </p>
      <div class="mt-7 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={business.phoneHref}
          class="hp-lift inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-solar px-7 py-3.5 font-display text-base font-bold text-navy shadow-md hover:bg-solar-dark hover:text-white transition-colors"
        >
          Call {business.phone}
        </a>
        <ScheduleButton class="w-full sm:w-auto px-7 py-3.5" />
      </div>
    </div>
  </article>
</BaseLayout>
