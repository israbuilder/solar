---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleButton from "../components/ScheduleButton.astro";
import { business } from "../data/business";
---
<BaseLayout
  title={`Our Mission & Community | ${business.name}`}
  description={`${business.name} is dedicated to empowering the Greater Houston community with clean, resilient solar power, grid resilience education, and sustainable energy independence.`}
  path="/community-mission"
>
  <!-- Hero Section -->
  <section class="relative isolate overflow-hidden bg-navy-800 text-white border-b-4 border-solar">
    <div class="max-w-6xl mx-auto px-6 py-20 lg:py-28 text-center">
      <p class="font-display font-bold text-solar-light uppercase tracking-[0.2em] text-sm">
        Environmental &amp; Community Commitment
      </p>
      <h1 class="hp-rise mt-4 font-display font-black text-4xl sm:text-5xl lg:text-6xl max-w-3xl mx-auto leading-tight">
        Powering a Cleaner, More Resilient Houston
      </h1>
      <p class="mt-6 text-white/80 text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed">
        Beyond installing panels and batteries, we are on a mission to safeguard Texas families against power grid failures and accelerate our transition to renewable energy.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a
          href="/contact"
          class="hp-lift inline-flex items-center justify-center bg-solar hover:bg-solar-dark text-navy hover:text-white px-8 py-3.5 rounded-xl font-display font-bold transition-colors"
        >
          Get in Touch
        </a>
        <ScheduleButton class="px-8 py-3.5" />
      </div>
    </div>
  </section>

  <!-- Pillars Section -->
  <section class="py-20 px-6 max-w-6xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="font-display font-bold text-3xl sm:text-4xl text-navy">
        Our Three Core Principles
      </h2>
      <p class="mt-4 text-navy/70 text-lg leading-relaxed">
        How {business.name} makes a lasting positive impact every single day across Greater Houston.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      <div class="bg-white rounded-3xl p-8 shadow-sm border border-navy/10 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-solar/15 flex items-center justify-center text-solar-dark font-bold text-2xl mb-6">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-xl text-navy">Decarbonization &amp; Clean Air</h3>
          <p class="mt-3 text-navy/75 leading-relaxed">
            Every residential solar array we install offsets metric tons of carbon emissions annually, promoting healthier air quality for Texas children and future generations.
          </p>
        </div>
      </div>

      <div class="bg-white rounded-3xl p-8 shadow-sm border border-navy/10 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-electric/15 flex items-center justify-center text-electric font-bold text-2xl mb-6">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-xl text-navy">Grid Resilience &amp; Safety</h3>
          <p class="mt-3 text-navy/75 leading-relaxed">
            By decentralizing power with distributed battery storage, we reduce peak load strain on ERCOT and keep local vulnerable households powered during severe storms.
          </p>
        </div>
      </div>

      <div class="bg-white rounded-3xl p-8 shadow-sm border border-navy/10 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-teal/15 flex items-center justify-center text-teal font-bold text-2xl mb-6">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-xl text-navy">Honest, Transparent Education</h3>
          <p class="mt-3 text-navy/75 leading-relaxed">
            We reject the misleading high-pressure sales tactics common in the solar sector. We deliver verifiable calculations, realistic financial payback models, and honest guidance.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
