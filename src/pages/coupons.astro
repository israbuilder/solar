---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleButton from "../components/ScheduleButton.astro";
import { business } from "../data/business";

const fine = "Cannot be combined with any other promotional discounts. Must be presented at time of initial agreement. Limited to one coupon per household or project.";

const coupons = [
  { amount: "$1,000 OFF", title: "Complete Solar System", detail: "Valid on any turnkey residential solar system of 8 kW or larger." },
  { amount: "$500 OFF", title: "Battery Storage", detail: "Valid on Tesla Powerwall or Enphase battery storage installation." },
  { amount: "FREE CHARGER", title: "Level 2 EV Station", detail: "Free Level 2 home EV charger included with whole-home solar + battery installation." },
  { amount: "$250 OFF", title: "Inverter or Repair", detail: "Valid on full inverter replacement or comprehensive system inspection." },
];
---
<BaseLayout
  title={`Solar Incentives & Coupons | ${business.name}`}
  description={`Exclusive solar incentives and discounts for Houston homeowners and businesses. Save on solar panels, Tesla Powerwalls, and inverter service with ${business.name}.`}
  path="/coupons"
>
  <!-- Banner -->
  <section class="bg-navy text-white border-b-4 border-solar">
    <div class="max-w-5xl mx-auto px-6 py-10 sm:py-16">
      <p class="font-display font-bold text-solar-light uppercase tracking-[0.2em] text-sm">Clean Energy Savings for Texas</p>
      <h1 class="hp-rise mt-2 font-display font-black text-3xl sm:text-5xl">Solar Incentives &amp; Coupons</h1>
      <p class="mt-3 text-white/80 text-lg max-w-2xl">
        Claim exclusive local discounts in addition to the 30% Federal Clean Energy Tax Credit (ITC).
      </p>
    </div>
  </section>

  <section class="px-6 py-12 sm:py-16 max-w-5xl mx-auto">
    <div id="coupon-wrap" class="relative">
      <div id="coupon-grid" class="grid gap-8 sm:grid-cols-2">
        {coupons.map((c) => (
          <div class="hp-lift relative flex flex-col bg-white rounded-3xl shadow-lg border-2 border-dashed border-solar overflow-hidden">
            <div class="flex-1 p-8 text-center">
              <span class="inline-block bg-solar text-navy font-display font-extrabold text-xs uppercase tracking-[0.2em] px-3.5 py-1.5 rounded-full">
                Solar Voucher
              </span>
              <p class="mt-4 font-display font-black text-4xl sm:text-5xl text-navy">{c.amount}</p>
              <h2 class="mt-3 font-display font-extrabold text-xl text-navy">{c.title}</h2>
              <p class="mt-2 text-navy/70 text-sm leading-relaxed">{c.detail}</p>
            </div>

            <div class="px-8 pb-8">
              <ScheduleButton class="w-full px-8 py-4 text-base" />
              <p class="mt-3 flex items-center justify-center gap-1.5 text-xs font-bold text-navy/60">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
                Screenshot voucher to redeem with your estimator
              </p>
              <p class="mt-4 text-[11px] text-navy/45 italic leading-relaxed text-center">{fine}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
