---
import BaseLayout from "../layouts/BaseLayout.astro";
import { business } from "../data/business";
---
<BaseLayout
  title={`Application Received — ${business.name} Careers`}
  description={`Thanks for applying to ${business.name}. We've received your application and will be in touch.`}
  path="/apply-received"
>
  <section class="bg-navy text-white border-b-4 border-solar">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <p class="font-display font-bold text-solar-light uppercase tracking-[0.2em] text-sm">Thank You</p>
      <h1 class="hp-rise mt-3 font-display font-black text-4xl sm:text-5xl">Application Received</h1>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-16">
    <div class="bg-cream rounded-3xl border border-navy/10 shadow-sm p-8 sm:p-10">
      <p class="text-navy/80 text-lg leading-relaxed">
        Thank you for your interest in joining {business.name}. We have received your application, and our hiring team will review your qualifications. If your skills match our open positions, we will reach out directly for an interview.
      </p>
      <p class="mt-4 text-navy/70">
        Have questions in the meantime? Feel free to contact our office at
        <a href={business.phoneHref} class="font-display font-bold text-solar-dark hover:text-navy transition-colors">{business.phone}</a>.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/careers" class="font-display font-bold text-navy hover:text-solar-dark transition-colors underline underline-offset-4">Back to Careers</a>
        <a href="/" class="font-display font-bold text-navy hover:text-solar-dark transition-colors underline underline-offset-4">Return Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
