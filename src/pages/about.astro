---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleButton from "../components/ScheduleButton.astro";
import { business } from "../data/business";
---
<BaseLayout
  title={`About Our Team | ${business.name}`}
  description={`Meet ${business.founder} and the dedicated solar engineering team behind ${business.name}. Delivering clean energy, honest advice, and 25-year reliability across Houston.`}
  path="/about"
>
  <!-- Banner -->
  <section class="bg-navy text-white border-b-4 border-solar">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <p class="font-display font-bold text-solar-light uppercase tracking-[0.2em] text-sm">Engineers &amp; Clean Energy Advocates</p>
      <h1 class="hp-rise mt-3 font-display font-black text-4xl sm:text-5xl">Meet the Solar Pro Team</h1>
      <p class="mt-4 text-white/80 text-lg max-w-2xl leading-relaxed">
        Passionate about empowering Texas families and businesses with clean, resilient, and cost-effective solar energy.
      </p>
    </div>
  </section>

  <section class="px-6 py-16 max-w-6xl mx-auto">
    <div class="grid gap-12 md:grid-cols-2 md:items-center">
      <div class="hp-zoom rounded-3xl shadow-xl border-4 border-solar overflow-hidden">
        <img
          src="/images/placeholder.jpeg"
          alt={`Team at ${business.name}`}
          width="600"
          height="600"
          loading="eager"
          class="w-full object-cover aspect-square"
        />
      </div>
      <div>
        <p class="text-navy/80 text-lg mb-4 leading-relaxed">
          Founded by {business.founder}, {business.name} was established with a clear mission: provide Houston homeowners and commercial property owners with transparent, high-integrity solar engineering without deceptive sales tactics or hidden fees.
        </p>
        <p class="text-navy/80 text-lg mb-4 leading-relaxed">
          Our in-house team of licensed electricians, NABCEP-certified solar professionals, and structural designers handle every stage of your transition to clean power — from 3D roof modeling and utility interconnection to battery commissioning.
        </p>
        <p class="font-display text-xl font-bold text-solar-dark italic mb-6">
          "{business.trustedPhrase}"
        </p>
        <p class="text-navy/80">
          Ready to discover your roof's solar potential? Call us directly at
          <a href={business.phoneHref} class="font-bold text-electric hover:text-navy transition-colors">{business.phone}</a>.
        </p>
        <div class="mt-7"><ScheduleButton class="px-8 py-4 text-lg" /></div>
      </div>
    </div>
  </section>

  <!-- Trust band -->
  <section class="relative isolate overflow-hidden bg-navy-800 text-white">
    <img src="/images/placeholder.jpeg" alt={`The ${business.name} team`} width="1600" height="600" loading="lazy" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-20" />
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h2 class="font-display font-extrabold text-3xl sm:text-4xl">A Local Houston Team You Can Trust</h2>
      <p class="mt-4 text-white/85 text-lg">{business.trustedPhrase} · NABCEP Certified · {business.rating.value}★ on Google</p>
      <div class="mt-8 flex justify-center"><ScheduleButton class="px-8 py-4 text-lg" /></div>
    </div>
  </section>
</BaseLayout>
