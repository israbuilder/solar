---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScheduleButton from "../../components/ScheduleButton.astro";
import { business } from "../../data/business";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order
);
---
<BaseLayout
  title={`Solar Power & Battery Services in Houston, TX | ${business.name}`}
  description={`${business.name} offers turnkey residential solar installation, commercial solar power, Tesla Powerwall battery storage, solar repairs, and EV charger integration across Houston, TX.`}
  path="/services"
>
  <!-- Banner -->
  <section class="bg-navy text-white border-b-4 border-solar">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <div class="flex items-center gap-2 font-display text-xs font-bold uppercase tracking-[0.2em] text-solar-light">
        <span class="h-2 w-2 rounded-full bg-solar"></span>
        Clean Energy Solutions
      </div>
      <h1 class="hp-rise mt-3 font-display font-black text-4xl sm:text-5xl">Houston Solar &amp; Battery Services</h1>
      <p class="mt-3 text-white/80 text-lg max-w-2xl">
        From residential rooftop solar arrays to hurricane-resilient battery backup systems, our certified electricians deliver clean power built for Texas.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((svc) => (
        <a href={`/services/${svc.id}`} class="hp-lift group bg-white rounded-2xl border border-navy/10 shadow-sm hover:shadow-xl hover:border-solar/40 p-6 flex flex-col transition-all">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-navy text-solar">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
            </svg>
          </span>
          <h2 class="mt-4 font-display font-bold text-xl text-navy group-hover:text-solar-dark transition-colors">{svc.data.h1}</h2>
          <p class="mt-2 text-sm text-navy/70 flex-1 leading-relaxed">{svc.data.summary}</p>
          <span class="mt-4 font-display font-bold text-electric text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
            Learn more 
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-14 bg-cream border border-navy/10 rounded-3xl p-8 sm:p-10 text-center shadow-sm">
      <h2 class="font-display font-extrabold text-2xl text-navy">Need a Custom Solar Assessment?</h2>
      <p class="mt-2 text-navy/70 max-w-xl mx-auto">
        Every roof and electric bill is different. Contact our engineers for a custom lidar scan, solar yield projection, and battery sizing. Call {business.phone}.
      </p>
      <div class="mt-6 flex justify-center"><ScheduleButton class="px-7 py-3.5" /></div>
    </div>
  </section>
</BaseLayout>
