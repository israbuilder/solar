---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleButton from "../components/ScheduleButton.astro";
import Reviews from "../components/Reviews.astro";
import { business } from "../data/business";
import { getCollection } from "astro:content";

// Specific service pages for deep keyword internal linking
const serviceLinks = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order
);

const services = [
  {
    title: "Residential Solar",
    desc: "Custom rooftop solar panels designed to eliminate skyrocketing Texas electric bills and maximize federal tax savings.",
    accent: "solar",
    icon: "sun",
    href: "/services/residential-solar-installation",
  },
  {
    title: "Battery Storage & Backup",
    desc: "Seamless whole-home backup power that keeps your AC, lights, and appliances running during hurricane and grid blackouts.",
    accent: "electric",
    icon: "battery",
    href: "/services/solar-battery-storage",
  },
  {
    title: "Commercial Solar Power",
    desc: "High-yield commercial solar arrays for warehouses, commercial rooftops, and carports to slash operating overhead.",
    accent: "eco",
    icon: "building",
    href: "/services/commercial-solar-systems",
  },
];

const painPoints = [
  "Are your summer Houston electric bills exceeding $400 to $600 each month?",
  "Did the last severe hurricane or winter freeze leave your family stranded without power?",
  "Are you tired of escalating utility rates and rising delivery charges?",
  "Are you frustrated by aggressive solar telemarketers and deceptive lease contracts?",
  "Do you want clean, automatic backup power without refueling loud gas generators?",
  "Are you looking to capture the 30% Federal Clean Energy Tax Credit before guidelines change?",
];

const stats = [
  {
    title: `${business.rating.count}+`,
    label: `${business.rating.value}★ Google Reviews`,
    link: business.socials.google,
  },
  {
    title: business.yearsTrusted,
    label: "Years Serving Houston",
    link: "/about",
  },
  {
    title: "NABCEP",
    label: "Certified & Licensed",
    link: "/services",
  },
  {
    title: "25 Years",
    label: "System Warranty",
    link: "/services",
  },
];

const projects = [
  { src: "/images/placeholder.jpeg", alt: `${business.name} residential solar installation in Katy` },
  { src: "/images/placeholder.jpeg", alt: `${business.name} battery backup system in Cypress` },
  { src: "/images/placeholder.jpeg", alt: `${business.name} commercial solar system in Houston` },
  { src: "/images/placeholder.jpeg", alt: `${business.name} EV charger and solar setup in The Woodlands` },
];
---
<BaseLayout
  title={`Houston Solar Panel Installation & Battery Backup | ${business.name}`}
  description={`Looking for trusted solar panel installers in Houston, TX? ${business.name} provides high-efficiency solar panel installation, Tesla Powerwall battery backups, commercial solar, and repairs. Call ${business.phone} today.`}
  path="/"
  includeReviews={true}
>
  <!-- HERO & STATS SECTION (Fits within 100vh viewport across resolutions) -->
  <div class="relative isolate overflow-hidden bg-navy-900 text-white flex flex-col justify-between lg:min-h-[calc(100svh-4rem)]">
    <!-- Background Photograph -->
    <div class="absolute inset-0 -z-20 overflow-hidden pointer-events-none">
      <img
        src="/images/background.jpg"
        alt="Houston solar panel installation on residential roof"
        width="2752"
        height="1536"
        loading="eager"
        class="h-full w-full object-cover object-right sm:object-center"
      />
      <!-- Soft directional scrim: soft shade on text area, transparent over solar roof -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#030c18]/75 via-[#030c18]/40 to-transparent"></div>
      <!-- Subtle bottom blend into the stats bar -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#030c18]/60 via-transparent to-transparent"></div>
    </div>

    <!-- Ambient Solar Glow -->
    <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 right-1/4 h-[500px] w-[500px] rounded-full bg-solar/15 blur-3xl"></div>
      <div class="absolute top-1/2 left-[-100px] h-[400px] w-[400px] rounded-full bg-teal/15 blur-3xl"></div>
    </div>

    <!-- MAIN HERO CONTENT -->
    <section class="flex-1 flex items-center py-6 sm:py-8 lg:py-6">
      <div class="max-w-[1680px] mx-auto px-4 sm:px-8 lg:px-10 xl:px-14 w-full">
        <div class="grid gap-6 lg:gap-8 lg:grid-cols-12 lg:items-center">
          <!-- Text Column with High Contrast Shadows -->
          <div class="lg:col-span-7 xl:col-span-6 relative">
            <h1 class="hp-rise font-display font-black text-3xl sm:text-4xl lg:text-[2.6rem] xl:text-5xl leading-[1.12] tracking-tight text-white drop-shadow-[0_4px_16px_rgba(0,0,0,0.85)] max-w-2xl">
              Slash Electric Bills &amp; Protect Your Home from <span class="text-transparent bg-clip-text bg-gradient-to-r from-solar via-teal-light to-blue-light drop-shadow">Grid Outages</span>
            </h1>

            <p class="hp-rise hp-delay-2 mt-3.5 text-sm sm:text-base lg:text-lg text-white/95 max-w-2xl leading-relaxed drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)] font-medium">
              Turnkey residential rooftop solar, Tesla Powerwall battery storage, and commercial clean energy systems engineered for the Texas climate. 25-year warranty protection with zero high-pressure sales.
            </p>

            <div class="hp-rise hp-delay-3 mt-5 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <ScheduleButton label="Get Free Solar Assessment" class="px-6 py-3.5 text-sm sm:text-base shadow-xl" />
              <a
                href={business.phoneHref}
                class="hp-lift inline-flex items-center justify-center gap-2 rounded-xl border border-white/30 bg-[#06162a]/80 hover:bg-[#06162a] backdrop-blur-md px-5 py-3 font-display text-sm sm:text-base font-bold text-white shadow-lg transition-colors"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>Call {business.phone}</span>
              </a>
            </div>

            <!-- Trust Badges Strip with Card Capsules for 100% Contrast -->
            <div class="hp-rise hp-delay-4 mt-6 pt-4 border-t border-white/20 flex flex-wrap items-center gap-2.5 sm:gap-3 text-xs font-semibold text-white/90">
              <span class="flex items-center gap-1.5 bg-[#06162a]/85 backdrop-blur-md px-3 py-1.5 rounded-lg border border-white/15 shadow-md">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="text-solar"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                30% Federal Tax Credit Eligible
              </span>
              <span class="flex items-center gap-1.5 bg-[#06162a]/85 backdrop-blur-md px-3 py-1.5 rounded-lg border border-white/15 shadow-md">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-solar"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                NABCEP Certified Installers
              </span>
              <span class="flex items-center gap-1.5 bg-[#06162a]/85 backdrop-blur-md px-3 py-1.5 rounded-lg border border-white/15 shadow-md">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-solar"><path d="M20 6L9 17l-5-5"/></svg>
                $0 Down Financing Available
              </span>
            </div>
          </div>

          <!-- Right Column: Minimalist Bottom-Right Stats positioned closer to the right edge -->
          <div class="lg:col-span-5 xl:col-span-6 flex flex-col justify-end lg:self-end pb-1 lg:pb-2 lg:items-end">
            <div class="inline-flex items-center gap-6 sm:gap-8 justify-start lg:justify-end text-left lg:text-right">
              <div>
                <p class="font-display font-black text-3xl sm:text-4xl lg:text-[2.75rem] text-solar-light leading-none drop-shadow-[0_2px_14px_rgba(0,0,0,0.95)]">
                  70% – 100%
                </p>
                <p class="text-xs sm:text-sm uppercase tracking-wider font-extrabold text-white drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)] mt-1.5">
                  Electric Bill Offset
                </p>
                <p class="text-[11px] text-white/75 drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)] mt-0.5">
                  Average Houston roof savings
                </p>
              </div>

              <div class="h-14 w-px bg-gradient-to-b from-transparent via-white/40 to-transparent shrink-0"></div>

              <div>
                <p class="font-display font-black text-3xl sm:text-4xl lg:text-[2.75rem] text-teal-light leading-none drop-shadow-[0_2px_14px_rgba(0,0,0,0.95)]">
                  25 Years
                </p>
                <p class="text-xs sm:text-sm uppercase tracking-wider font-extrabold text-white drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)] mt-1.5">
                  Production Guarantee
                </p>
                <p class="text-[11px] text-white/75 drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)] mt-0.5">
                  Full hardware &amp; labor warranty
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS RIBBON (Always visible docked at the bottom of the first viewport) -->
    <section class="bg-navy-700/80 backdrop-blur-sm border-t border-white/10 text-white shrink-0 py-3 sm:py-3.5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        {stats.map((item) => (
          <a href={item.link} class="hp-lift group block py-1 px-2">
            <p class="font-display font-black text-2xl sm:text-3xl text-solar-light group-hover:scale-105 transition-transform">
              {item.title}
            </p>
            <p class="mt-0.5 text-xs sm:text-sm text-white/80 font-medium">
              {item.label}
            </p>
          </a>
        ))}
      </div>
    </section>
  </div>

  <!-- CORE SERVICES SECTION -->
  <section class="px-6 py-20 bg-cream">
    <div class="max-w-6xl mx-auto">
      <p class="text-center font-display font-bold text-solar-dark uppercase tracking-[0.2em] text-sm">Clean Energy Infrastructure</p>
      <h2 class="mt-2 text-center font-display font-black text-3xl sm:text-4xl text-navy">Solar Engineered the Right Way</h2>
      <p class="text-center text-navy/70 mt-3 max-w-2xl mx-auto">
        Residential and commercial clean energy solutions — tailored for Houston homeowners, developers, and facility managers.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {services.map((s) => (
          <a href={s.href} class="hp-lift group bg-white rounded-3xl p-8 border border-navy/10 shadow-sm hover:shadow-xl hover:border-teal/50 flex flex-col transition-all">
            <div class={`inline-flex h-14 w-14 items-center justify-center rounded-2xl ${s.accent === "solar" ? "bg-solar text-navy" : s.accent === "electric" ? "bg-teal text-navy" : "bg-blue text-white"}`}>
              {s.icon === "sun" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="5"/>
                  <line x1="12" y1="1" x2="12" y2="3"/>
                  <line x1="12" y1="21" x2="12" y2="23"/>
                  <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                  <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                  <line x1="1" y1="12" x2="3" y2="12"/>
                  <line x1="21" y1="12" x2="23" y2="12"/>
                  <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                  <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                </svg>
              )}
              {s.icon === "battery" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="1" y="6" width="18" height="12" rx="2"/>
                  <line x1="23" y1="13" x2="23" y2="11"/>
                  <line x1="7" y1="12" x2="13" y2="12"/>
                  <line x1="10" y1="9" x2="10" y2="15"/>
                </svg>
              )}
              {s.icon === "building" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
                  <line x1="9" y1="22" x2="9" y2="22.01"/>
                  <line x1="15" y1="22" x2="15" y2="22.01"/>
                  <line x1="9" y1="6" x2="9" y2="6.01"/>
                  <line x1="15" y1="6" x2="15" y2="6.01"/>
                  <line x1="9" y1="10" x2="9" y2="10.01"/>
                  <line x1="15" y1="10" x2="15" y2="10.01"/>
                  <line x1="9" y1="14" x2="9" y2="14.01"/>
                  <line x1="15" y1="14" x2="15" y2="14.01"/>
                  <line x1="9" y1="18" x2="9" y2="18.01"/>
                  <line x1="15" y1="18" x2="15" y2="18.01"/>
                </svg>
              )}
            </div>
            <h3 class="mt-6 font-display font-bold text-2xl text-navy group-hover:text-solar-dark transition-colors">{s.title}</h3>
            <p class="mt-2 text-navy/70 leading-relaxed flex-1">{s.desc}</p>
            <span class="mt-6 font-display font-bold text-electric text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
              Explore service →
            </span>
          </a>
        ))}
      </div>

      <!-- Keyword Anchors to All Service Pages -->
      <ul class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {serviceLinks.map((s) => (
          <li>
            <a
              href={`/services/${s.id}`}
              class="hp-lift group flex items-center justify-between gap-3 bg-white hover:border-solar rounded-2xl border border-navy/10 px-5 py-4 shadow-sm transition-all"
            >
              <span class="font-display font-bold text-navy group-hover:text-solar-dark transition-colors text-sm sm:text-base">{s.data.h1}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-solar shrink-0" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-10 text-center">
        <a href="/services" class="font-display font-bold text-electric hover:text-navy transition-colors text-lg">
          View all Houston solar &amp; battery services →
        </a>
      </div>
    </div>
  </section>

  <!-- FOUNDER QUOTE BAND -->
  <section class="bg-white px-6 py-20 border-y border-navy/10">
    <div class="max-w-5xl mx-auto grid gap-10 md:grid-cols-[auto_1fr] md:items-center">
      <img
        src="/images/placeholder.jpeg"
        alt={`The engineering team at ${business.name}`}
        width="240"
        height="240"
        loading="lazy"
        class="h-44 w-44 md:h-56 md:w-56 rounded-3xl object-cover border-4 border-solar shadow-lg mx-auto"
      />
      <div>
        <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" class="text-solar" aria-hidden="true"><path d="M9.5 4C6.5 4 4 6.5 4 9.5c0 3 2.5 5.5 5.5 5.5.3 0 .5 0 .8-.1-.6 2-2.3 3.6-4.3 4.1l.5 1.9c3.8-.9 6.7-4.4 6.7-8.4V9.5C13.2 6.5 11 4 9.5 4zm9 0C15.5 4 13 6.5 13 9.5c0 3 2.5 5.5 5.5 5.5.3 0 .5 0 .8-.1-.6 2-2.3 3.6-4.3 4.1l.5 1.9c3.8-.9 6.7-4.4 6.7-8.4V9.5C22.2 6.5 20 4 18.5 4z"/></svg>
        <p class="mt-4 font-display font-bold text-2xl sm:text-3xl text-navy leading-snug">
          We treat every Houston home and commercial roof like our own — transparent numbers, top-tier Tier-1 hardware, and genuine Texas accountability.
        </p>
        <p class="mt-4 font-semibold text-solar-dark">— {business.founder}, {business.name}</p>
        <div class="mt-6">
          <a href="/about" class="font-display font-bold text-electric hover:text-navy transition-colors">
            Meet Our Leadership &amp; Crew →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- PAIN POINTS / TEXAS GRID STRESS -->
  <section class="px-6 py-20 bg-navy text-white">
    <div class="max-w-5xl mx-auto">
      <div class="text-center">
        <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-solar-light">Energy Independence</span>
        <h2 class="mt-2 font-display font-black text-3xl sm:text-4xl">Are You Tired of High Bills and Grid Failures?</h2>
        <p class="text-white/70 mt-3 max-w-xl mx-auto">If any of these sound familiar, {business.name} has the clean energy solution.</p>
      </div>

      <ul class="mt-12 grid gap-4 sm:grid-cols-2">
        {painPoints.map((p) => (
          <li class="flex gap-3.5 items-start bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-solar-light shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-white/90 leading-relaxed">{p}</span>
          </li>
        ))}
      </ul>

      <div class="mt-12 text-center">
        <ScheduleButton label="Check Your Roof Savings Now" class="px-8 py-4 text-base" />
      </div>
    </div>
  </section>

  <!-- PROJECT GALLERY STRIP -->
  <section class="px-6 py-20 bg-cream">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between flex-wrap gap-4">
        <div>
          <p class="font-display font-bold text-solar-dark uppercase tracking-[0.2em] text-sm">Our Workmanship</p>
          <h2 class="mt-2 font-display font-black text-3xl sm:text-4xl text-navy">Recent Houston Installations</h2>
        </div>
        <a href="/projects" class="font-display font-bold text-electric hover:text-navy transition-colors">
          View full solar gallery →
        </a>
      </div>

      <div class="mt-10 grid gap-5 grid-cols-2 lg:grid-cols-4">
        {projects.map((p) => (
          <div class="hp-zoom hp-lift rounded-2xl shadow-sm border border-navy/10 overflow-hidden bg-white">
            <img src={p.src} alt={p.alt} width="500" height="500" loading="lazy" class="h-56 w-full object-cover" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REVIEWS SECTION -->
  <Reviews />

  <!-- DYNAMIC BLOG TEASER BANNER (Points to /blog) -->
  <section class="tips-banner" aria-labelledby="tips-title">
    <div class="tips-banner__content">
      <p class="tips-banner__eyebrow">Solar Energy Tips &amp; Advice</p>

      <h2 id="tips-title">
        Smart Solar &amp; Battery Guides That Save You Money
      </h2>

      <p class="tips-banner__description">
        Learn how Texas solar buyback plans work, understand battery backup sizing during hurricane season, and maximize your 30% federal tax credit.
      </p>

      <a class="tips-banner__button" href="/blog">
        Explore Solar Blog
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="tips-banner__image">
      <img
        src="/images/placeholder.jpeg"
        alt={`${business.name} technician inspecting a rooftop solar array`}
        width="720"
        height="520"
        loading="lazy"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .tips-banner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    max-width: 1180px;
    min-height: 390px;
    margin: 80px auto;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(
        circle at 15% 20%,
        rgb(48 192 208 / 22%),
        transparent 40%
      ),
      #0a1f38;
    border: 1px solid rgb(48 192 208 / 25%);
    border-radius: 28px;
    box-shadow: 0 24px 60px rgb(4 25 48 / 18%);
  }

  .tips-banner__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(36px, 6vw, 72px);
  }

  .tips-banner__eyebrow {
    margin: 0 0 14px;
    color: #30c0d0;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .tips-banner h2 {
    max-width: 650px;
    margin: 0;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 900;
  }

  .tips-banner__description {
    max-width: 580px;
    margin: 16px 0 28px;
    color: rgb(255 255 255 / 80%);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .tips-banner__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    padding: 14px 28px;
    color: #0a1f38;
    background: #ffa000;
    border-radius: 12px;
    font-weight: 800;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 10px 25px rgb(255 160 0 / 25%);
    transition: all 0.25s ease;
  }

  .tips-banner__button:hover {
    background: #e68a00;
    color: #ffffff;
    transform: translateY(-2px);
  }

  .tips-banner__image {
    position: relative;
    overflow: hidden;
  }

  .tips-banner__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .tips-banner {
      grid-template-columns: 1fr;
      margin: 40px 16px;
    }
    .tips-banner__image {
      min-height: 240px;
    }
  }
</style>
